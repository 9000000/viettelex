<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- On-demand: chỉ tải khi người dùng bấm "Tải tính năng Dịch" trong app. -->
    <dist:module dist:title="@string/translate_feature_title">
        <dist:delivery>
            <dist:on-demand />
        </dist:delivery>
        <dist:fusing dist:include="false" />
    </dist:module>

    <application>
        <!-- ML Kit: không tự khởi tạo lúc mở process (IME chạy chung process) — MlKitBackend
             khởi tạo khi được nạp. Manifest module gộp vào manifest gốc ⇒ phải gỡ ở đây. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>
</manifest>
