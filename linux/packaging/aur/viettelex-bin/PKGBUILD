  "${_gh}/viettelex-fcitx5_${pkgver}.${_series}1_arm64.deb"
  "${_gh}/viettelex-ibus_${pkgver}.${_series}1_arm64.deb"
  "${_gh}/viettelex-text-tools_${pkgver}.${_series}1_arm64.deb"
